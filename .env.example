HOST=0.0.0.0
PORT=8080
WORKERS=4
LOG_LEVEL=info
# Without cookies: only 'auto' mode available (anonymous)
# PERPLEXITY_COOKIES={"next-auth.session-token": "your-token-here"}
# CLIProxyAPI base-url must be http://127.0.0.1:8080 (no /v1 suffix)
CACHE_ENABLED=true
CACHE_MAX_SIZE=256
CACHE_TTL_SECONDS=300
REFRESH_SECRET=change-me-in-production
